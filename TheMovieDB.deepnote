          sortingKey: "000101"
          type: text-cell-p
          content: Il grafo di collaborazione tra attori **non è un grafo connesso**
          metadata:
            deepnote_app_block_visible: true
            formattedRanges:
              - type: marks
                marks:
                  bold: true
